{
  "name": "code-diff-app",
  "productName": "Code Diff Tool",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app to review GitLab and GitHub merge requests and pull requests together with their issues",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "app": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/start.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "icon": "electron scripts/make-icon.cjs",
    "screenshots": "electron-vite build && node scripts/screenshots.cjs",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "dist": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dist.ts",
    "dist:release": "electron-vite build && electron-builder",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "electron-log": "5.4.4",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "author": "Caliel Lima da Costa",
  "build": {
    "appId": "dev.caliel.code-diff-tool",
    "productName": "Code Diff Tool",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "protocols": [
      {
        "name": "Code Diff Tool",
        "schemes": [
          "codediff"
        ]
      }
    ],
    "artifactName": "Code-Diff-Tool-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "afterPack": "scripts/ad-hoc-sign.cjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calielc/code-diff-tool.git"
  },
  "bugs": {
    "url": "https://github.com/calielc/code-diff-tool/issues"
  },
  "homepage": "https://github.com/calielc/code-diff-tool#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml,css,html,mjs}": [
      "prettier --check"
    ]
  }
}
